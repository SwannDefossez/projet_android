<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#E62E4568"
                android:startColor="#E61A2538" />
            <corners android:radius="999dp" />
            <stroke
                android:width="1.4dp"
                android:color="#B3FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#CC1D2D48"
                android:startColor="#CC0B1320" />
            <corners android:radius="999dp" />
            <stroke
                android:width="1.4dp"
                android:color="#B319C6B4" />
        </shape>
    </item>
</selector>
